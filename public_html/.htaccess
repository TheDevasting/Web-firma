# ==========================================================
# .htaccess - Legalmente
# (Renombra este archivo a ".htaccess" al subirlo al hosting)
# ==========================================================

# ----------------------------------------------------------
# 1. Forzar HTTPS
#    Activa esto SOLO cuando el certificado SSL ya esté
#    instalado; si no, nadie podrá entrar al sitio.
#    La segunda condición evita bucles de redirección si el
#    hosting usa un proxy (por ejemplo Cloudflare).
# ----------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ----------------------------------------------------------
# 2. No listar el contenido de las carpetas
# ----------------------------------------------------------
Options -Indexes

# ----------------------------------------------------------
# 3. Bloquear archivos ocultos (.git, .env...) y sensibles
#    (.log, .sql, .bak, .ini, .env, .sh)
#    Se incluyen las dos sintaxis para que funcione en
#    servidores Apache nuevos y antiguos.
# ----------------------------------------------------------
<IfModule mod_authz_core.c>
    <FilesMatch "(^\.|\.(log|sql|bak|ini|env|sh)$)">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "(^\.|\.(log|sql|bak|ini|env|sh)$)">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# ----------------------------------------------------------
# 4. Cabeceras de seguridad HTTP
# ----------------------------------------------------------
<IfModule mod_headers.c>
    # Impide que otros sitios metan tu página dentro de un iframe
    Header always set X-Frame-Options "DENY"
    # Evita que el navegador "adivine" tipos de archivo
    Header always set X-Content-Type-Options "nosniff"
    # Controla cuánta información del origen se envía a otros sitios
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Desactiva funciones del navegador que el sitio no usa
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    # CSP: solo permite cargar recursos de tu propio sitio y de Google Fonts / cdnjs.
    # Bloquea scripts inyectados. Si luego alojas fuentes e íconos tú mismo,
    # quita https://fonts.googleapis.com, https://fonts.gstatic.com y https://cdnjs.cloudflare.com.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"

    # HSTS: obliga a los navegadores a usar siempre HTTPS.
    # Descomenta SOLO cuando HTTPS funcione bien en todo el sitio.
    # Primero prueba con max-age=300 (5 minutos); luego sube a 31536000 (1 año).
    # Header always set Strict-Transport-Security "max-age=300"
</IfModule>

# ----------------------------------------------------------
# 5. Ocultar la versión del servidor en páginas de error
# ----------------------------------------------------------
ServerSignature Off

# ----------------------------------------------------------
# 6. Página de error 404 personalizada
#    (crea un archivo 404.html y quita el # de abajo)
# ----------------------------------------------------------
# ErrorDocument 404 /404.html

# ----------------------------------------------------------
# 7. Compresión y caché de imágenes (el sitio carga más rápido)
#    El CSS no se cachea por mucho tiempo para que tus
#    cambios se vean enseguida mientras desarrollas.
# ----------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png  "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
</IfModule>